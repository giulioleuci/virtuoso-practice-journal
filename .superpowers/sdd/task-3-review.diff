+  async restore(collection: Collection, links: Pick<CollectionItem, "collectionId" | "itemId" | "position">[]) { const { deletedAt: _deletedAt, ...row } = collection; await db.transaction("rw", db.collections, db.collectionItems, async () => { await db.collections.put({ ...row, deletedAt: undefined, updatedAt: now() }); if (links.length) await db.collectionItems.bulkAdd(links.map((link) => ({ ...link, createdAt: now() }))); }); },
+  async listForItem(itemId: number) { const links = await db.collectionItems.where("itemId").equals(itemId).toArray(); const rows = await db.collections.where("id").anyOf(links.map((link) => link.collectionId)).toArray(); return rows.filter(active).sort((a, b) => a.name.localeCompare(b.name)); },
