+import { db } from "@/infrastructure/dexie/db";
+import type { Lesson, LessonRecurrence } from "@/domain/entities/lesson";
+import { now } from "@/lib/date";
+export async function buildDexieLessonSnapshot(subjectId: number, recurrence: LessonRecurrence | null | undefined, piecePlayedIds: number[] = []) { const [subject, pieces] = await Promise.all([db.subjects.get(subjectId), piecePlayedIds.length ? db.library.where("id").anyOf(piecePlayedIds).toArray() : []]); return { snapshot: { subjectName: subject?.name ?? "—", teacher: recurrence?.teacher, frequency: recurrence?.schedules?.[0]?.frequency }, piecesPlayedTitles: pieces.map((piece) => piece.title) }; }
+export const lessonRepository = {
+  upsertRecurrence: async (data: Omit<LessonRecurrence, "id">, id?: number) => { if (id) { await db.recurrences.put({ ...data, id }); return id; } return db.recurrences.add(data) as Promise<number>; }, deleteRecurrence: async (id: number) => { await db.recurrences.delete(id); },
+  async log(subjectId: number, recurrence: LessonRecurrence | null | undefined, date: string, notes: string | undefined, assignmentTexts: string[]) { const { snapshot, piecesPlayedTitles } = await buildDexieLessonSnapshot(subjectId, recurrence); const ts = now(); let id = 0; await db.transaction("rw", db.lessons, db.assignments, async () => { id = await db.lessons.add({ recurrenceId: recurrence?.id, subjectId, date, notes: notes?.trim() || undefined, piecesPlayed: [], snapshot, piecesPlayedTitles, createdAt: ts }) as number; if (assignmentTexts.length) await db.assignments.bulkAdd(assignmentTexts.map((text) => ({ lessonId: id, text, transformed: false, createdAt: ts }))); }); return id; },
+  async updateLesson(lesson: Lesson, date: string, notes: string | undefined, texts: string[]) { await db.transaction("rw", db.lessons, db.assignments, async () => { await db.lessons.put({ ...lesson, date, notes: notes?.trim() || undefined }); await db.assignments.where("lessonId").equals(lesson.id!).delete(); if (texts.length) await db.assignments.bulkAdd(texts.map((text) => ({ lessonId: lesson.id!, text, transformed: false, createdAt: now() }))); }); },
+  async deleteLesson(id: number) { await db.transaction("rw", db.lessons, db.assignments, async () => { await db.assignments.where("lessonId").equals(id).delete(); await db.lessons.delete(id); }); },
+  ignoreAssignment: async (id: number) => { await db.assignments.update(id, { ignored: true }); }, restoreAssignment: async (id: number) => { await db.assignments.update(id, { ignored: false }); }, transformAssignment: async (id: number, taskId: number) => { await db.assignments.update(id, { transformed: true, taskId }); },
+};
