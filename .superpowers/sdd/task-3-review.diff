+import { z } from "zod";
+import { db } from "@/infrastructure/dexie/db";
+const schema = z.object({ version: z.number().optional(), exportedAt: z.number().optional(), data: z.record(z.string(), z.array(z.record(z.string(), z.unknown()))).optional() });
+export const backupRepository = { async exportAll() { const data: Record<string, unknown> = {}; for (const table of db.tables) data[table.name] = await table.toArray(); return JSON.stringify({ version: 2, exportedAt: Date.now(), data }, null, 2); }, async importAll(json: string) { const parsed = schema.parse(JSON.parse(json)); if (parsed.version != null && ![1, 2].includes(parsed.version)) throw new Error(`Unsupported backup version: ${parsed.version}`); await db.transaction("rw", db.tables, async () => { for (const table of db.tables) { await table.clear(); const rows = parsed.data?.[table.name]; if (rows?.length) await table.bulkAdd(rows); } }); }, async wipeAll() { await db.transaction("rw", db.tables, async () => { for (const table of db.tables) await table.clear(); }); } };
