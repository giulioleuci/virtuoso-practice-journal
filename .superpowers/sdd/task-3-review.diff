+  update: async (id: number, patch: Partial<Session>) => { await db.sessions.update(id, patch); }, remove: async (id: number) => { await db.sessions.delete(id); },
+  async logWithCompletion(task: Task, input: FullSessionLogInput) { const recordSnapshot = await buildDexieSessionSnapshot({ ...task, layers: input.layersUsed, techniqueIds: input.techniquesUsed, targetBpm: input.bpmReached ?? task.targetBpm, noteVal: input.noteVal ?? task.noteVal }); const ts = now(); let id = 0; await db.transaction("rw", db.tasks, db.sessions, db.helpRequests, async () => { id = await db.sessions.add({ taskId: task.id!, date: input.date, bpmReached: input.bpmReached, noteVal: input.noteVal, reps: input.reps, confidence: input.confidence, quality: input.quality, notes: input.notes?.trim() || undefined, layersUsed: input.layersUsed, techniquesUsed: input.techniquesUsed, layerScores: input.layerScores, techniqueScores: input.techniqueScores, segmentMetrics: input.segmentMetrics, snapshot: recordSnapshot, createdAt: ts }) as number; await db.tasks.update(task.id!, { done: true }); if (input.helpText) await db.helpRequests.add({ sessionId: id, taskId: task.id!, itemId: task.itemId, question: input.helpText, resolved: false, createdAt: ts }); }); return id; },
