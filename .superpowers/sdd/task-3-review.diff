+  async setItemCollections(itemId: number, collectionIds: number[]) { const wanted = new Set(collectionIds); await db.transaction("rw", db.collectionItems, async () => { const links = await db.collectionItems.where("itemId").equals(itemId).toArray(); const have = new Set(links.map((link) => link.collectionId)); const remove = links.filter((link) => !wanted.has(link.collectionId)).map((link) => link.id); const add = [...wanted].filter((id) => !have.has(id)); if (remove.length) await db.collectionItems.bulkDelete(remove); if (add.length) await db.collectionItems.bulkAdd(add.map((collectionId) => ({ collectionId, itemId, createdAt: now() }))); }); },
+  async addItems(collectionId: number, itemIds: number[]) { if (!itemIds.length) return; await db.transaction("rw", db.collectionItems, async () => { const have = new Set((await db.collectionItems.where("collectionId").equals(collectionId).toArray()).map((link) => link.itemId)); const add = itemIds.filter((id) => !have.has(id)); if (add.length) await db.collectionItems.bulkAdd(add.map((itemId) => ({ collectionId, itemId, createdAt: now() }))); }); },
+  async removeItems(collectionId: number, itemIds: number[]) { const links = await db.collectionItems.where("collectionId").equals(collectionId).filter((link) => itemIds.includes(link.itemId)).toArray(); if (links.length) await db.collectionItems.bulkDelete(links.map((link) => link.id)); }, countItems: (id: number) => db.collectionItems.where("collectionId").equals(id).count(),
+  async groupLibraryByCollection(kind: LibraryKind = "repertoire"): Promise<{ collection: Collection | null; items: LibraryItem[] }[]> { const [collections, items, links] = await Promise.all([this.list(kind), db.library.where("kind").equals(kind).filter(active).toArray(), db.collectionItems.toArray()]); const byId = new Map(items.map((item) => [item.id!, item])); const memberIds = new Set<number>(); const map = new Map<number, number[]>(); for (const link of links) if (byId.has(link.itemId)) { memberIds.add(link.itemId); map.set(link.collectionId, [...(map.get(link.collectionId) ?? []), link.itemId]); } return [...collections.map((collection) => ({ collection, items: (map.get(collection.id!) ?? []).map((id) => byId.get(id)!).sort((a,b) => a.title.localeCompare(b.title)) })), { collection: null, items: items.filter((item) => !memberIds.has(item.id!)).sort((a,b) => a.title.localeCompare(b.title)) }]; },
